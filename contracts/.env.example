# Sepolia deployment uses a Foundry keystore via --account, not a raw key here.
DEPLOYER_ADDRESS=0xYourKeystoreAddress
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POOL_MANAGER=0xVerifyAgainstOfficialSepoliaDeployments
CRE_FORWARDER=0xVerifyAgainstOfficialCREForwarderDirectory
CRE_SIMULATION=true
USE_CHAINLINK_FEEDS=true
USDC_FEED=0xVerifyFreshFeed
ETH_FEED=0xVerifyFreshFeed
BTC_FEED=0xVerifyFreshFeed
LINK_FEED=0xVerifyFreshFeed
TREASURY=0xYourTestnetTreasury
# For a non-simulation receiver, configure actual workflow identity.
WORKFLOW_ID=0xActualWorkflowId32Bytes
WORKFLOW_AUTHOR=0xActualWorkflowOwner
# First ten ASCII hex characters of SHA256(workflow name), encoded as bytes10,
# then right-padded to bytes32 for the deployment script's environment reader.
WORKFLOW_NAME=0xEncodedNameRightPaddedTo32Bytes

# Explicit test-only fallback for an unavailable feed, never silent:
USE_MOCK_USDC_FEED=false
USE_MOCK_ETH_FEED=false
USE_MOCK_BTC_FEED=false
USE_MOCK_LINK_FEED=false
