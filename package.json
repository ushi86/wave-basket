{
  "name": "wave-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["web", "cre"],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && npm run test:contracts",
    "test:contracts": "forge test --root contracts",
    "contracts:build": "forge build --root contracts",
    "demo": "node scripts/local-demo.mjs"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "@foundry-rs/anvil": "1.7.1",
    "@openzeppelin/contracts": "5.4.0",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6"
  }
}
